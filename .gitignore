# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Accidental virtual environment currently located inside app/api
/app/api/Include/
/app/api/Lib/
/app/api/Scripts/
/app/api/pyvenv.cfg

# Environment and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Tests, coverage, and type/lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Build and packaging artifacts
dist/
build/
*.egg-info/
.eggs/

# Local tools and agent state
/app/curl
/app/curl.exe
.codex/
.agents/

# Credentials and private keys
.aws/
.azure/
.kube/
.docker/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
kubeconfig
kubeconfig.*
secrets/
secrets.yaml
secrets.yml
*.secrets.yaml
*.secrets.yml

# Terraform local state and potentially sensitive variable files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraformrc
terraform.rc
credentials.tfrc.json

# Local application data
*.db
*.sqlite
*.sqlite3

# Generated Helm manifests, revision exports, and chart packages
/helm/rendered*.yaml
/helm/rendered*.yml
/helm/**/revision-*.yaml
/helm/**/revision-*.yml
/revision-*.yaml
/revision-*.yml
/helm/**/*.tgz
