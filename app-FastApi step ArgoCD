Create:

D:\GitHub\FastApiArgoProject\argocd\medical-api-application.yaml
apiVersion: argoproj.io/v1alpha1
kind: Application

metadata:
  name: medical-api
  namespace: argocd

spec:
  project: default

  source:
    repoURL: https://github.com/datik2012-jpg/FastApiArgoProject.git
    targetRevision: main
    path: helm/medical-api

    helm:
      valueFiles:
        - values.yaml

  destination:
    server: https://kubernetes.default.svc
    namespace: medical-argocd

  syncPolicy:
    automated:
      prune: true
      selfHeal: true

    syncOptions:
      - CreateNamespace=true




