Step 3 — Replace values.yaml

Use:

replicaCount: 1

image:
  repository: medical-api
  tag: "1.0.1"
  pullPolicy: Never

service:
  type: ClusterIP
  port: 80
  targetPort: 8000

config:
  appName: "Medical Appointment API"
  appVersion: "1.0.1"
  environment: "development"

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 256Mi

probes:
  readiness:
    path: /ready
    initialDelaySeconds: 3
    periodSeconds: 5

  liveness:
    path: /health
    initialDelaySeconds: 10
    periodSeconds: 10

autoscaling:
  enabled: true
  minReplicas: 1
